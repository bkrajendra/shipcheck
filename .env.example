# ShipCheck needs a model provider credential for `flue run` to actually call the LLM.
# Provider is picked by useModel()'s specifier prefix in src/agents/ship-check.ts
# (default: anthropic/claude-sonnet-4-6). Set the matching key below.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model specifier without touching code, e.g. to try
# a different provider. Format is 'provider-id/model-id' (see the Flue docs'
# Models guide for the full provider list and each one's required env var).
# SHIPCHECK_MODEL=moonshotai/kimi-k2-0905-preview
# MOONSHOT_API_KEY=sk-...

# Optional: point ShipCheck at a different repository than the one you run it from.
# Defaults to the current working directory when unset.
# SHIPCHECK_TARGET_DIR=/absolute/path/to/some/other/repo
